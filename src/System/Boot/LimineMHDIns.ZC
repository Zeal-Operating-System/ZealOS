
#ifndef binary_limine_hdd_bin_data
U8 binary_limine_hdd_bin_data[0];
#endif

Bool LimineCFGMake(U8 drv_let)
{
	U8		*filename_cfg = MStrPrint("%C:/Boot/Limine.CONF", drv_let);
	CDoc	*doc = DocNew(filename_cfg);
	CDrive	*drive;
	CBlkDev	*bd;
	I64		 i;
	U8		*filename_sys, *filename_elf, *filename_zxe, *st;

	"\nGenerating Limine.CONF ...\n";

	DocPrint(doc,
		"timeout: 2\n"
		"interface_resolution: 1024x768\n\n");

	"Searching drives for Limine bootloader files ...\n";
	for (i = 0, drive = blkdev.drvs; i < DRIVES_NUM; i++, drive++)
	{
		if (drive->drive_signature == DRIVE_SIGNATURE_VAL && drive->fs_type == FSt_FAT32 && DriveIsWritable(drive->drv_let))
		{
			bd = drive->bd;
			drv_let = Drive2Letter(drive);

			filename_sys = MStrPrint("%C:/Boot/Limine-BIOS.SYS", drv_let);
			filename_elf = MStrPrint("%C:/Boot/ZealBooter.ELF", drv_let);
			filename_zxe = MStrPrint("%C:/Boot/Kernel.ZXE", drv_let);
			if (FileFind(filename_sys) && FileFind(filename_elf) && FileFind(filename_zxe))
			{
				st = MStrPrint("/ZealOS %C:/\n"
					"protocol: limine\n"
					"resolution: 1024x768\n"
					"path: boot(%d):/Boot/ZealBooter.ELF\n"
					"module_path: boot(%d):/Boot/Kernel.ZXE\n"
					"\n", drv_let, drive->prt_num + 1, drive->prt_num + 1);

				DocPrint(doc, st);
				"%C:/ drive added as a Limine.CONF menu entry.\n", drv_let;
			}
			else
				"%C:/ drive is missing Limine bootloader files.\n", drv_let;
		}
	}
	DocWrite(doc);
	DocDel(doc);

	"/Boot/Limine.CONF generated.\n";

	"Copying Limine.CONF to all other drives ...\n";
	for (i = 0, drive = blkdev.drvs; i < DRIVES_NUM; i++, drive++)
	{
		if (drive->drive_signature == DRIVE_SIGNATURE_VAL && drive->fs_type == FSt_FAT32 && DriveIsWritable(drive->drv_let))
		{
			drv_let = Drive2Letter(drive);
			if (FileFind(filename_sys) && FileFind(filename_elf) && FileFind(filename_zxe))
			{
				st = MStrPrint("%C:/Boot/Limine.CONF", drv_let);
				Copy(filename_cfg, st);
			}
		}
	}

	return TRUE;
}

#define LIMINE_MBR_GAP_BLKS	63		// MBR + post-MBR gap, limine bios-install refuses partitions starting inside it
#define LIMINE_STAGE2_LOC	0x1000	// byte offset limine bios-install puts stage 2 at, a multiple of any sector size

Bool LimineMBRCheck(CMasterBoot *mbr)
{
	I64  i;
	Bool any_active = FALSE;

	for (i = 0; i < 4; i++)
		if (mbr->p[i].type && mbr->p[i].offset < LIMINE_MBR_GAP_BLKS)
		{
			"\n" ST_ERR_ST "A partition's start sector is less than %d.\n", LIMINE_MBR_GAP_BLKS;
			return FALSE;
		}

	for (i = 0; i < 4; i++)
	{
		if (mbr->p[i].active != 0x00 && mbr->p[i].active != 0x80)
			break;
		if (mbr->p[i].active)
			any_active = TRUE;
	}

	if (i < 4 || mbr->signature != 0xAA55)
	{
		"\n" ST_ERR_ST "Could not determine if the disk has a valid partition table.\n";
		return FALSE;
	}

	if (!any_active)
	{
		"No active partition found, setting partition 1 as active.\n";
		mbr->p[0].active = 0x80;
	}

	return TRUE;
}

Bool LimineMHDIns(U8 drv_let)
{
	U8			*limine			= binary_limine_hdd_bin_data, *blks;
	U16			 limine_size	= sizeof(binary_limine_hdd_bin_data);
	U64			*limine_stage2;
	CBlkDev		*bd = Letter2BlkDev(drv_let);
	CMasterBoot	 old_mbr, *new_mbr;

	if (limine_size == 0)
	{
		"\n" ST_ERR_ST "Limine HDD MBR binary bytes not found. Must first #include it, then recompile this file.\n";
		return FALSE;
	}

	if (limine_size - BLK_SIZE > LIMINE_MBR_GAP_BLKS * BLK_SIZE - LIMINE_STAGE2_LOC)
	{
		"\n" ST_ERR_ST "Limine HDD stage 2 does not fit in the post-MBR gap.\n";
		return FALSE;
	}

	'\n';

	blks = MAlloc(LIMINE_MBR_GAP_BLKS * BLK_SIZE);
	new_mbr = blks;
	limine_stage2 = blks + 0x1A4; // where the Limine MBR code looks for stage 2

	BlkDevLock(bd);
	AHCIAtaBlksRead(bd, blks, 0, LIMINE_MBR_GAP_BLKS); // read old MBR and post-MBR gap currently on disk
	BlkDevUnlock(bd);

	if (!LimineMBRCheck(new_mbr))
	{
		Free(blks);
		return FALSE;
	}

	// read the whole MBR + post-MBR-gap that Limine wants to overwrite, save all of that as an OldMBR.BIN
	BootMHDOldRead(drv_let, drv_let, LIMINE_MBR_GAP_BLKS);

	MemCopy(&old_mbr, blks, BLK_SIZE);
	MemCopy(new_mbr, limine, BLK_SIZE);
	MemCopy(blks + LIMINE_STAGE2_LOC, limine + BLK_SIZE, limine_size - BLK_SIZE);
	*limine_stage2 = LIMINE_STAGE2_LOC;

	MemCopy(new_mbr->code + 218, old_mbr.code + 218, 6); // keep the disk timestamp
	new_mbr->media_id = old_mbr.media_id;
	new_mbr->zero = old_mbr.zero;
	MemCopy(new_mbr->p, old_mbr.p, sizeof(CMasterBoot.p)); // copy old MBR partition table to new Limine MBR

	BlkDevLock(bd);
	AHCIAtaBlksWrite(bd, blks, 0, 1); // write Limine to MBR
	AHCIAtaBlksWrite(bd, blks + LIMINE_STAGE2_LOC, LIMINE_STAGE2_LOC / BLK_SIZE,
		CeilU64(limine_size - BLK_SIZE, BLK_SIZE) / BLK_SIZE); // write stage 2 to post-MBR gap
	BlkDevUnlock(bd);

	Free(blks);

	LimineCFGMake(drv_let);

	"\nLimine BSD2-licensed HDD MBR Boot Loader installed.\n\n";

	return TRUE;

}
