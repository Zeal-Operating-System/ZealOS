//xHCI (USB3) host controller driver. Polled, no MSI.
//Commands are issued from the USB task, or from the boot task before it exists.
//Sync transfers may be awaited from any task; a per-controller poll_lock keeps
//the boot task and the USB task from draining an event ring concurrently.
//
//All controllers run at once: a machine has several (Thunderbolt/USB4 plus PCH)
//and a USB-C dock can land an ethernet NIC on one while HID sits on another.
//usb_xhci is only the default for calls that don't name a controller.
CXhciGlobals	 usb_hcs[USB_HCS_MAX];
I64				 usb_hc_count = 0;
CXhciGlobals	*usb_xhci = &usb_hcs[0];
CUsbDev			 usb_devs[USB_DEVS_MAX];
CTask			*usb_task = NULL;
U8				 usb_boot_iso_drv_let = 0;

//Controller-scoped calls take an hc; NULL means the active controller. Code
//holding a CUsbDev passes dev->hc, since slot ids and port numbers are only
//unique within one controller.
U32 XhciCapR32(I64 off, CXhciGlobals *hc=NULL)
{
	U32 *p;

	if (!hc) hc = usb_xhci;
	p = hc->mmio + off;

	return *p;
}

U32 XhciOpR32(I64 off, CXhciGlobals *hc=NULL)
{
	U32 *p;

	if (!hc) hc = usb_xhci;
	p = hc->op + off;

	return *p;
}

U0 XhciOpW32(I64 off, I64 val, CXhciGlobals *hc=NULL)
{
	U32 *p;

	if (!hc) hc = usb_xhci;
	p = hc->op + off;
	*p = val;
}

U0 XhciOpW64(I64 off, I64 val, CXhciGlobals *hc=NULL)
{
	U64 *p;

	if (!hc) hc = usb_xhci;
	p = hc->op + off;
	*p = val;
}

U32 XhciRtR32(I64 off, CXhciGlobals *hc=NULL)
{
	U32 *p;

	if (!hc) hc = usb_xhci;
	p = hc->rt + off;

	return *p;
}

U0 XhciRtW32(I64 off, I64 val, CXhciGlobals *hc=NULL)
{
	U32 *p;

	if (!hc) hc = usb_xhci;
	p = hc->rt + off;
	*p = val;
}

U0 XhciRtW64(I64 off, I64 val, CXhciGlobals *hc=NULL)
{
	U64 *p;

	if (!hc) hc = usb_xhci;
	p = hc->rt + off;
	*p = val;
}

U32 XhciPortSC(I64 port, CXhciGlobals *hc=NULL)
{
	return XhciOpR32(XHCI_OP_PORTSC_BASE + 0x10 * port, hc);
}

U0 XhciPortSCWrite(I64 port, I64 val, CXhciGlobals *hc=NULL)
{
	XhciOpW32(XHCI_OP_PORTSC_BASE + 0x10 * port, val, hc);
}

U0 XhciLock(CXhciGlobals *hc=NULL)
{
	if (!hc) hc = usb_xhci;
	while (LBts(&hc->lock, 0))
		Yield;
}

U0 XhciUnlock(CXhciGlobals *hc=NULL)
{
	if (!hc) hc = usb_xhci;
	LBtr(&hc->lock, 0);
}

U0 XhciRingInit(CXhciRing *ring)
{
	if (!ring->trbs)
		ring->trbs = CAllocAligned(XHCI_RING_TRBS * sizeof(CXhciTRB), 0x1000, sys_task->code_heap);
	else
		MemSet(ring->trbs, 0, XHCI_RING_TRBS * sizeof(CXhciTRB));
	ring->enq = 0;
	ring->cycle = 1;
}

CXhciRing *XhciEPRingInit(CUsbEP *ep)
{//Alloc ep's ring struct (pointer member) on first use, then (re)init it.
	if (!ep->ring)
		ep->ring = CAlloc(sizeof(CXhciRing), sys_task->code_heap);
	XhciRingInit(ep->ring);

	return ep->ring;
}

CXhciTRB *XhciRingEnq(CXhciRing *ring, I64 lo, I64 hi, I64 status, I64 control)
{//control passed without cycle bit; caller holds lock.
	CXhciTRB *trb = &ring->trbs[ring->enq], *link;
	I64		  addr;

	trb->lo		 = lo;
	trb->hi		 = hi;
	trb->status	 = status;
	trb->control = (control & ~1) | ring->cycle;
	ring->enq++;
	if (ring->enq == XHCI_RING_TRBS - 1)
	{//Place link TRB back to start, toggle cycle.
		link = &ring->trbs[XHCI_RING_TRBS - 1];
		addr = ring->trbs;
		link->lo	  = addr & 0xFFFFFFFF;
		link->hi	  = addr >> 32;
		link->status  = 0;
		link->control = (XHCI_TRB_LINK << 10) | XHCI_TRBF_TC | ring->cycle;
		ring->enq	  = 0;
		ring->cycle	 ^= 1;
	}

	return trb;
}

I64 XhciHcIdx(CXhciGlobals *hc)
{//Index of a controller in usb_hcs, or -1.
	I64 n;

	for (n = 0; n < usb_hc_count; n++)
		if (&usb_hcs[n] == hc)
			return n;

	return -1;
}

CUsbDev *UsbDevBySlot(I64 slot, CXhciGlobals *hc=NULL)
{
	I64 i;

	if (!hc) hc = usb_xhci;
	for (i = 0; i < USB_DEVS_MAX; i++)
		if (usb_devs[i].present && usb_devs[i].hc == hc && usb_devs[i].slot == slot)
			return &usb_devs[i];

	return NULL;
}

CUsbDev *UsbDevByPort(I64 port, CXhciGlobals *hc=NULL)
{//Root-port devices only; hub children share their root port number.
	I64 i;

	if (!hc) hc = usb_xhci;
	for (i = 0; i < USB_DEVS_MAX; i++)
		if (usb_devs[i].present && usb_devs[i].hc == hc &&
			usb_devs[i].port == port && !usb_devs[i].depth)
			return &usb_devs[i];

	return NULL;
}

CUsbEP *UsbDevEPByDCI(CUsbDev *dev, I64 dci)
{
	I64 i;

	if (dci == 1)
		return &dev->ep0;
	for (i = 0; i < dev->ep_count; i++)
		if (dev->ep_list[i].valid && dev->ep_list[i].dci == dci)
			return &dev->ep_list[i];

	return NULL;
}

U0 XhciIntQueue(CUsbDev *dev, CUsbEP *ep)
{//Queue one interrupt IN TRB on ep; report dispatched via ep->auto_kind.
	CXhciGlobals *hc = dev->hc;

	XhciLock(hc);
	ep->pending_trb = XhciRingEnq(ep->ring, ep->auto_buf, 0, ep->auto_len,
								  (XHCI_TRB_NORMAL << 10) | XHCI_TRBF_IOC | XHCI_TRBF_ISP);
	hc->db[dev->slot] = ep->dci;
	XhciUnlock(hc);
}

U0 XhciEventPoll(CXhciGlobals *hc=NULL)
{//Drain one controller's event ring. USB task, or an inline waiter.
	CXhciTRB	*e;
	CUsbDev		*dev;
	CUsbEP		*ep;
	I64			 type, code, slot, dci, addr, work = FALSE;
	U64			*erdp;

	if (!hc) hc = usb_xhci;
	if (!hc->running)
		return;
	while (LBts(&hc->poll_lock, 0))
		Yield;
	while (TRUE)
	{
		e = &hc->evt_ring[hc->evt_deq];
		if ((e->control & 1) != hc->evt_cycle)
			break;
		work = TRUE;
		type = (e->control >> 10) & 0x3F;
		switch (type)
		{
			case XHCI_TRB_EVT_CMD_DONE:
				hc->cmd_code = (e->status >> 24) & 0xFF;
				hc->cmd_slot = (e->control >> 24) & 0xFF;
				addr = hc->cmd_trb;
				if (hc->cmd_trb && e->lo == addr & 0xFFFFFFFF)
					hc->cmd_done = TRUE;
				break;

			case XHCI_TRB_EVT_TRANSFER:
				slot = (e->control >> 24) & 0xFF;
				dci  = (e->control >> 16) & 0x1F;
				code = (e->status >> 24) & 0xFF;
				dev  = UsbDevBySlot(slot, hc);
				if (dev)
				{
					ep = UsbDevEPByDCI(dev, dci);
					if (ep)
					{
						if (ep->auto_kind)
						{//Deliver + requeue. Residue lets ECM derive the length.
							ep->xfer_residue = e->status & 0xFFFFFF;
							if (code == XHCI_CC_SUCCESS || code == XHCI_CC_SHORT_PKT)
							{
								switch (ep->auto_kind)
								{
									case USB_AUTO_KBD:
										UsbKbdCB(dev, ep);
										break;
									case USB_AUTO_MOUSE:
										UsbMouseCB(dev, ep);
										break;
									case USB_AUTO_ECM:
										UsbEcmRxCB(dev, ep);
										break;
								}
							}
							XhciIntQueue(dev, ep);
						}
						else
						{
							ep->xfer_code	 = code;
							ep->xfer_residue = e->status & 0xFFFFFF;
							ep->xfer_done	 = TRUE;
						}
					}
				}
				break;

			case XHCI_TRB_EVT_PORT_SC:
				hc->port_change = TRUE;
				break;
		}
		hc->evt_deq++;
		if (hc->evt_deq == XHCI_EVT_RING_TRBS)
		{
			hc->evt_deq = 0;
			hc->evt_cycle ^= 1;
		}
	}
	if (work)
	{
		addr = hc->evt_ring + hc->evt_deq;
		erdp = hc->rt + XHCI_RT_ERDP0;
		*erdp = addr | 8;	//8 = clear Event Handler Busy
	}
	LBtr(&hc->poll_lock, 0);
}

I64 XhciCmd(I64 lo, I64 hi, I64 status, I64 control, I64 *_slot=NULL,
			CXhciGlobals *hc=NULL)
{//Issue one command TRB, wait completion. USB task only.
	F64 timeout;

	if (!hc) hc = usb_xhci;
	XhciLock(hc);
	hc->cmd_done = FALSE;
	hc->cmd_code = XHCI_CC_TIMEOUT;
	hc->cmd_trb  = XhciRingEnq(&hc->cmd_ring, lo, hi, status, control);
	hc->db[0] = 0;
	XhciUnlock(hc);
	timeout = tS + 1.0;
	while (!hc->cmd_done && tS < timeout)
	{
		XhciEventPoll(hc);
		Yield;
	}
	if (_slot)
		*_slot = hc->cmd_slot;
	if (!hc->cmd_done)
		return XHCI_CC_TIMEOUT;

	return hc->cmd_code;
}

I64 XhciXferWait(CUsbEP *ep, F64 timeout_s, CXhciGlobals *hc=NULL)
{
	F64 timeout = tS + timeout_s;

	while (!ep->xfer_done && tS < timeout)
	{
		if (Fs == usb_task || !usb_task)
			XhciEventPoll(hc);
		Yield;
	}
	if (!ep->xfer_done)
		return XHCI_CC_TIMEOUT;

	return ep->xfer_code;
}

I64 XhciCtrlXfer(CUsbDev *dev, I64 rt, I64 rq, I64 val, I64 idx, U8 *buf, I64 len)
{//Control transfer on EP0. Returns completion code.
	CUsbEP			*ep = &dev->ep0;
	CXhciGlobals	*hc = dev->hc;
	I64				 trt, ctl, addr;

	if (len)
	{
		if (rt & USB_RT_DEV_TO_HOST)
			trt = XHCI_TRT_IN;
		else
			trt = XHCI_TRT_OUT;
	}
	else
		trt = XHCI_TRT_NO_DATA;
	XhciLock(hc);
	ep->xfer_done	 = FALSE;
	ep->xfer_code	 = XHCI_CC_TIMEOUT;
	ep->xfer_residue = 0;
	XhciRingEnq(ep->ring, rt | (rq << 8) | (val << 16), idx | (len << 16), 8,
				(XHCI_TRB_SETUP << 10) | XHCI_TRBF_IDT | trt);
	if (len)
	{
		ctl = XHCI_TRB_DATA << 10;
		if (rt & USB_RT_DEV_TO_HOST)
			ctl |= XHCI_TRBF_DIR_IN;
		addr = buf;
		XhciRingEnq(ep->ring, addr & 0xFFFFFFFF, addr >> 32, len, ctl);
	}
	ctl = (XHCI_TRB_STATUS << 10) | XHCI_TRBF_IOC;
	if (!len || !(rt & USB_RT_DEV_TO_HOST))
		ctl |= XHCI_TRBF_DIR_IN;	//status stage opposite dir; IN if no data
	XhciRingEnq(ep->ring, 0, 0, 0, ctl);
	hc->db[dev->slot] = 1;
	XhciUnlock(hc);

	return XhciXferWait(ep, 1.0, hc);
}

I64 XhciBulkXfer(CUsbDev *dev, CUsbEP *ep, U8 *buf, I64 len, F64 timeout_s, I64 *_residue=NULL)
{//Single-TRB bulk transfer (max 64KB). Returns completion code.
	CXhciGlobals	*hc = dev->hc;
	I64				 addr = buf, code;

	XhciLock(hc);
	ep->xfer_done	 = FALSE;
	ep->xfer_code	 = XHCI_CC_TIMEOUT;
	ep->xfer_residue = 0;
	XhciRingEnq(ep->ring, addr & 0xFFFFFFFF, addr >> 32, len,
				(XHCI_TRB_NORMAL << 10) | XHCI_TRBF_IOC | XHCI_TRBF_ISP);
	hc->db[dev->slot] = ep->dci;
	XhciUnlock(hc);
	code = XhciXferWait(ep, timeout_s, hc);
	if (_residue)
		*_residue = ep->xfer_residue;

	return code;
}

U32 *XhciInputCtx(CUsbDev *dev, I64 idx)
{//idx: 0=input control ctx, 1=slot ctx, 1+dci=EP ctx
	U32 *p = dev->in_ctx + idx * dev->hc->ctx_size;

	return p;
}

U32 *XhciDevCtxGet(CUsbDev *dev, I64 idx)
{//idx: 0=slot ctx, dci=EP ctx
	U32 *p = dev->dev_ctx + idx * dev->hc->ctx_size;

	return p;
}

I64 XhciEPInterval(CUsbDev *dev, CUsbEP *ep)
{//EP context Interval field, units of 125us * 2^n.
	I64 v = ep->interval, n;

	if (dev->speed == USB_SPEED_HIGH || dev->speed == USB_SPEED_SUPER)
	{
		if (v < 1)
			v = 1;
		if (v > 16)
			v = 16;
		return v - 1;
	}
//FS/LS: bInterval is in ms; pick n with 2^(n-3) ms >= v.
	n = 3;
	while ((1 << (n - 3)) < v && n < 10)
		n++;

	return n;
}

I64 XhciEPCtxType(CUsbEP *ep)
{
	I64 t = ep->attr & 3, in = FALSE;

	if (ep->addr & 0x80)
		in = TRUE;
	if (t == USB_EP_TYPE_BULK)
	{
		if (in)
			return XHCI_EP_TYPE_BULK_IN;
		return XHCI_EP_TYPE_BULK_OUT;
	}
	if (t == USB_EP_TYPE_INT)
	{
		if (in)
			return XHCI_EP_TYPE_INT_IN;
		return XHCI_EP_TYPE_INT_OUT;
	}
	if (t == USB_EP_TYPE_ISOCH)
	{
		if (in)
			return XHCI_EP_TYPE_ISOCH_IN;
		return XHCI_EP_TYPE_ISOCH_OUT;
	}

	return XHCI_EP_TYPE_CTRL;
}

I64 XhciEnableSlot(CXhciGlobals *hc=NULL)
{//Returns slot id, or 0 on failure.
	I64 slot = 0, code;

	code = XhciCmd(0, 0, 0, XHCI_TRB_ENABLE_SLOT << 10, &slot, hc);
	if (code != XHCI_CC_SUCCESS)
		return 0;

	return slot;
}

U0 XhciDisableSlot(I64 slot, CXhciGlobals *hc=NULL)
{
	XhciCmd(0, 0, 0, (XHCI_TRB_DISABLE_SLOT << 10) | (slot << 24),, hc);
}

I64 XhciAddressDev(CUsbDev *dev)
{//Alloc contexts + EP0 ring, issue Address Device. Returns completion code.
	CXhciGlobals	*hc = dev->hc;
	U32				*icc, *slot_ctx, *ep0_ctx;
	I64				 mps, addr;

	if (!dev->dev_ctx)
		dev->dev_ctx = CAllocAligned(hc->ctx_size * 32, 0x1000, sys_task->code_heap);
	else
		MemSet(dev->dev_ctx, 0, hc->ctx_size * 32);
	if (!dev->in_ctx)
		dev->in_ctx = CAllocAligned(hc->ctx_size * 33, 0x1000, sys_task->code_heap);
	else
		MemSet(dev->in_ctx, 0, hc->ctx_size * 33);
	XhciEPRingInit(&dev->ep0);
	dev->ep0.dci = 1;
	dev->ep0.valid = TRUE;
	dev->ep0.auto_kind = USB_AUTO_NONE;

	switch (dev->speed)
	{
		case USB_SPEED_LOW:
		case USB_SPEED_FULL:
			mps = 8;
			break;
		case USB_SPEED_HIGH:
			mps = 64;
			break;
		default:
			mps = 512;
	}
	dev->ep0.max_packet = mps;

	icc = XhciInputCtx(dev, 0);
	icc[0] = 0;
	icc[1] = 3;	//add slot + EP0
	slot_ctx = XhciInputCtx(dev, 1);
	slot_ctx[0] = (1 << 27) | (dev->speed << 20) | (dev->route & 0xFFFFF);
	slot_ctx[1] = (dev->port + 1) << 16;	//root hub port (top of the tree)
//TT: a LS/FS device behind a HS hub gets its transactions translated by that
//hub. Point the slot at the parent hub's slot + port so the HC targets its TT.
	if (dev->parent_slot &&
		(dev->speed == USB_SPEED_LOW || dev->speed == USB_SPEED_FULL))
		slot_ctx[2] = (dev->parent_slot & 0xFF) | ((dev->parent_port & 0xFF) << 8);
	ep0_ctx = XhciInputCtx(dev, 2);
	ep0_ctx[1] = (3 << 1) | (XHCI_EP_TYPE_CTRL << 3) | (mps << 16);
	addr = dev->ep0.ring->trbs;
	ep0_ctx[2] = (addr & 0xFFFFFFFF) | 1;	//DCS=1
	ep0_ctx[3] = addr >> 32;
	ep0_ctx[4] = 8;

	hc->dcbaa[dev->slot] = dev->dev_ctx;
	addr = dev->in_ctx;

	return XhciCmd(addr & 0xFFFFFFFF, addr >> 32, 0,
				   (XHCI_TRB_ADDRESS_DEV << 10) | (dev->slot << 24),, hc);
}

I64 XhciEvalCtxMPS0(CUsbDev *dev, I64 mps)
{//Update EP0 max packet size after reading device descriptor.
	CXhciGlobals	*hc = dev->hc;
	U32				*icc, *ep0_ctx;
	I64				 addr;

	MemSet(dev->in_ctx, 0, hc->ctx_size * 33);
	icc = XhciInputCtx(dev, 0);
	icc[0] = 0;
	icc[1] = 2;	//A1 = EP0
	ep0_ctx = XhciInputCtx(dev, 2);
	MemCopy(ep0_ctx, XhciDevCtxGet(dev, 1), hc->ctx_size);
	ep0_ctx[1] = (ep0_ctx[1] & 0xFFFF) | (mps << 16);
	dev->ep0.max_packet = mps;
	addr = dev->in_ctx;

	return XhciCmd(addr & 0xFFFFFFFF, addr >> 32, 0,
				   (XHCI_TRB_EVAL_CTX << 10) | (dev->slot << 24),, hc);
}

I64 XhciConfigureEPs(CUsbDev *dev)
{//Build input context with all parsed EPs, issue Configure Endpoint.
	CXhciGlobals	*hc = dev->hc;
	U32				*icc, *slot_ctx, *ep_ctx;
	CUsbEP			*ep;
	I64				 i, addr, max_dci = 1, type, ival;

	MemSet(dev->in_ctx, 0, hc->ctx_size * 33);
	icc = XhciInputCtx(dev, 0);
	icc[0] = 0;
	icc[1] = 1;	//A0 = slot
	for (i = 0; i < dev->ep_count; i++)
	{
		ep = &dev->ep_list[i];
		if (!ep->valid)
			goto next_ep;
		XhciEPRingInit(ep);
		icc[1] |= 1 << ep->dci;
		if (ep->dci > max_dci)
			max_dci = ep->dci;
		ep_ctx = XhciInputCtx(dev, 1 + ep->dci);
		type = XhciEPCtxType(ep);
		ival = XhciEPInterval(dev, ep);
		ep_ctx[0] = ival << 16;
		ep_ctx[1] = (3 << 1) | (type << 3) | (ep->max_packet << 16);
		addr = ep->ring->trbs;
		ep_ctx[2] = (addr & 0xFFFFFFFF) | 1;
		ep_ctx[3] = addr >> 32;
		if ((ep->attr & 3) == USB_EP_TYPE_INT)
			ep_ctx[4] = ep->max_packet | (ep->max_packet << 16);
		else
			ep_ctx[4] = 1024;
next_ep:;
	}
	slot_ctx = XhciInputCtx(dev, 1);
	MemCopy(slot_ctx, XhciDevCtxGet(dev, 0), hc->ctx_size);
	slot_ctx[0] = (slot_ctx[0] & 0x07FFFFFF) | (max_dci << 27);
//Hub: advertise it to the HC so it routes traffic to downstream ports.
	if (dev->is_hub)
	{
		slot_ctx[0] = slot_ctx[0] | (1 << 26);			//Hub
		if (dev->hub_mtt)
			slot_ctx[0] = slot_ctx[0] | (1 << 25);		//Multi-TT
		slot_ctx[1] = (slot_ctx[1] & 0x00FFFFFF) | ((dev->hub_ports & 0xFF) << 24);
		slot_ctx[2] = (slot_ctx[2] & ~(3 << 16)) | ((dev->hub_tt_think & 3) << 16);
	}
	addr = dev->in_ctx;

	return XhciCmd(addr & 0xFFFFFFFF, addr >> 32, 0,
				   (XHCI_TRB_CONFIG_EP << 10) | (dev->slot << 24),, hc);
}

I64 XhciResetEP(CUsbDev *dev, CUsbEP *ep)
{//Recover a halted endpoint: Reset EP + Set TR Dequeue to fresh ring.
	CXhciGlobals	*hc = dev->hc;
	I64				 code, addr;

	code = XhciCmd(0, 0, 0,
				   (XHCI_TRB_RESET_EP << 10) | (ep->dci << 16) | (dev->slot << 24),, hc);
	XhciEPRingInit(ep);
	addr = ep->ring->trbs;
	code = XhciCmd((addr & 0xFFFFFFFF) | 1, addr >> 32, 0,
				   (XHCI_TRB_SET_TR_DEQ << 10) | (ep->dci << 16) | (dev->slot << 24),, hc);

	return code;
}

U0 XhciBiosHandoff(CXhciGlobals *hc=NULL)
{
	I64	 hcc, xecp, id, next;
	U32	*cap;
	F64	 timeout;

	if (!hc) hc = usb_xhci;
	hcc  = XhciCapR32(XHCI_CAP_HCCPARAMS1, hc);
	xecp = ((hcc >> 16) & 0xFFFF) * 4;
	while (xecp)
	{
		cap = hc->mmio + xecp;
		id = *cap & 0xFF;
		if (id == 1)
		{//USB Legacy Support: claim OS ownership
			*cap = *cap | (1 << 24);
			timeout = tS + 1.0;
			while ((*cap & (1 << 16)) && tS < timeout)
				Sleep(10);
			break;
		}
		next = (*cap >> 8) & 0xFF;
		if (!next)
			break;
		xecp += next * 4;
	}
}

Bool XhciPortReset(I64 port, CXhciGlobals *hc=NULL)
{//Reset root port, wait for enabled. Returns TRUE if port enabled.
	I64	sc;
	F64	timeout;

	XhciPortSCWrite(port, XHCI_PORTSC_PP | XHCI_PORTSC_PR, hc);
	timeout = tS + 0.5;
	while (tS < timeout)
	{
		sc = XhciPortSC(port, hc);
		if (sc & XHCI_PORTSC_PED)
			break;
		Sleep(10);
	}
//Clear change bits
	XhciPortSCWrite(port, XHCI_PORTSC_PP | XHCI_PORTSC_CHANGE_BITS, hc);
	sc = XhciPortSC(port, hc);

	return ToBool(sc & XHCI_PORTSC_PED);
}

U8 *XhciMmioMap(I64 phys)
{//UEFI parks xHCI BARs above 4GB, past the low-4GB uncached alias. ZealBooter
//stretches mem_physical_space to cover them, so the BAR is already identity
//mapped: flip its page to uncached. No TLB flush; the page is untouched.
	I64 *pte, base = phys & ~(mem_page_size - 1);

	pte  = MemPageTable(base);
	*pte = *pte | 0x10; //PCD: uncached
	return phys;
}

Bool XhciHcStart(CXhciGlobals *hc, I64 bdf)
{//Bring one controller up: map BAR, reset, alloc rings/contexts, run, power
//ports. TRUE if it is running.
	I64	 bar_lo, bar_hi, addr, i, hcs1, hcs2, hcc, cmd;
	F64	 timeout;
	U8	*page;

	MemSet(hc, 0, sizeof(CXhciGlobals));
	hc->pci_bus = bdf.u8[2];
	hc->pci_dev = bdf.u8[1];
	hc->pci_fun = bdf.u8[0];

	bar_lo = PCIReadU32(hc->pci_bus, hc->pci_dev, hc->pci_fun, 0x10);
	bar_hi = 0;
	if ((bar_lo & 6) == 4)	//64-bit BAR
		bar_hi = PCIReadU32(hc->pci_bus, hc->pci_dev, hc->pci_fun, 0x14);
	addr = bar_hi << 32 | bar_lo & ~0xF;
	if (!addr)
		return FALSE;	//BAR not assigned
//Enable memory space + bus master
	cmd = PCIReadU16(hc->pci_bus, hc->pci_dev, hc->pci_fun, 4);
	PCIWriteU16(hc->pci_bus, hc->pci_dev, hc->pci_fun, 4, cmd | 6);

	if (bar_hi)
		hc->mmio = XhciMmioMap(addr);	//BAR above 4GB gets its own mapping
	else
		hc->mmio = dev.uncached_alias + addr;
	hc->op	= hc->mmio + (XhciCapR32(XHCI_CAP_CAPLENGTH, hc) & 0xFF);
	hc->rt	= hc->mmio + (XhciCapR32(XHCI_CAP_RTSOFF, hc) & ~0x1F);
	hc->db	= hc->mmio + (XhciCapR32(XHCI_CAP_DBOFF, hc) & ~3);

	hcs1 = XhciCapR32(XHCI_CAP_HCSPARAMS1, hc);
	hcs2 = XhciCapR32(XHCI_CAP_HCSPARAMS2, hc);
	hcc  = XhciCapR32(XHCI_CAP_HCCPARAMS1, hc);
	hc->max_slots = hcs1 & 0xFF;
	hc->max_ports = (hcs1 >> 24) & 0xFF;
	if (hcc & 4)
		hc->ctx_size = 64;
	else
		hc->ctx_size = 32;

	XhciBiosHandoff(hc);

//Stop + reset controller
	XhciOpW32(XHCI_OP_USBCMD, XhciOpR32(XHCI_OP_USBCMD, hc) & ~XHCI_CMD_RS, hc);
	timeout = tS + 1.0;
	while (!(XhciOpR32(XHCI_OP_USBSTS, hc) & XHCI_STS_HCH) && tS < timeout)
		Sleep(1);
	XhciOpW32(XHCI_OP_USBCMD, XHCI_CMD_HCRST, hc);
	timeout = tS + 1.0;
	while ((XhciOpR32(XHCI_OP_USBCMD, hc) & XHCI_CMD_HCRST) && tS < timeout)
		Sleep(1);
	timeout = tS + 1.0;
	while ((XhciOpR32(XHCI_OP_USBSTS, hc) & XHCI_STS_CNR) && tS < timeout)
		Sleep(1);

	XhciOpW32(XHCI_OP_CONFIG, hc->max_slots, hc);

//Device context base address array
	hc->dcbaa = CAllocAligned((hc->max_slots + 1) * 8, 0x1000, sys_task->code_heap);

//Scratchpad buffers
	hc->scratch_count = (((hcs2 >> 21) & 0x1F) << 5) | ((hcs2 >> 27) & 0x1F);
	if (hc->scratch_count)
	{
		hc->scratch_arr = CAllocAligned(hc->scratch_count * 8, 0x1000, sys_task->code_heap);
		for (i = 0; i < hc->scratch_count; i++)
		{
			page = CAllocAligned(0x1000, 0x1000, sys_task->code_heap);
			hc->scratch_arr[i] = page;
		}
		hc->dcbaa[0] = hc->scratch_arr;
	}
	XhciOpW64(XHCI_OP_DCBAAP, hc->dcbaa, hc);

//Command ring
	XhciRingInit(&hc->cmd_ring);
	addr = hc->cmd_ring.trbs;
	XhciOpW64(XHCI_OP_CRCR, addr | 1, hc);

//Event ring, single segment, interrupter 0
	hc->evt_ring = CAllocAligned(XHCI_EVT_RING_TRBS * sizeof(CXhciTRB), 0x1000, sys_task->code_heap);
	hc->evt_deq = 0;
	hc->evt_cycle = 1;
	hc->erst = CAllocAligned(64, 64, sys_task->code_heap);
	addr = hc->evt_ring;
	hc->erst[0] = addr;
	hc->erst[1] = XHCI_EVT_RING_TRBS;
	XhciRtW32(XHCI_RT_ERSTSZ0, 1, hc);
	XhciRtW64(XHCI_RT_ERDP0, addr, hc);
	addr = hc->erst;
	XhciRtW64(XHCI_RT_ERSTBA0, addr, hc);
//Interrupts stay disabled; we poll.

//Run
	XhciOpW32(XHCI_OP_USBCMD, XhciOpR32(XHCI_OP_USBCMD, hc) | XHCI_CMD_RS, hc);
	timeout = tS + 1.0;
	while ((XhciOpR32(XHCI_OP_USBSTS, hc) & XHCI_STS_HCH) && tS < timeout)
		Sleep(1);
	if (XhciOpR32(XHCI_OP_USBSTS, hc) & XHCI_STS_HCH)
		return FALSE;	//never left halt

	hc->present = TRUE;
	hc->running = TRUE;

//Ports come up unpowered on real hardware; no CCS until PP is set.
	for (i = 0; i < hc->max_ports; i++)
		XhciPortSCWrite(i, XHCI_PORTSC_PP, hc);

	return TRUE;
}

public I64 XhciInitAll()
{//Bring up every xHCI controller. Devices are spread across them: a USB-C dock
//can put an ethernet NIC on the Thunderbolt controller while HID sits on the
//PCH one. Returns the number running.
	CXhciGlobals	*hc;
	I64				 n, i, bdf;

	usb_hc_count = 0;
	for (n = 0; usb_hc_count < USB_HCS_MAX; n++)
	{
		bdf = PCIClassFind(XHCI_PCI_CLASS, n);
		if (bdf == -1)
			break;
		hc = &usb_hcs[usb_hc_count];
		if (XhciHcStart(hc, bdf))
		{
			"xHCI #%d at %02X:%02X:%01X: %d ports, %d slots.\n",
					usb_hc_count, hc->pci_bus, hc->pci_dev, hc->pci_fun,
					hc->max_ports, hc->max_slots;
			usb_hc_count++;
		}
	}
	if (!usb_hc_count)
	{
		"xHCI: no usable controller found.\n";
		usb_xhci = &usb_hcs[0];
		return 0;
	}
	Sleep(20);	//port power settle
//Default target for calls that don't name a controller: prefer one with a
//device connected.
	usb_xhci = &usb_hcs[0];
	for (n = 0; n < usb_hc_count; n++)
		for (i = 0; i < usb_hcs[n].max_ports; i++)
			if (XhciPortSC(i, &usb_hcs[n]) & XHCI_PORTSC_CCS)
			{
				usb_xhci = &usb_hcs[n];
				return usb_hc_count;
			}

	return usb_hc_count;
}

