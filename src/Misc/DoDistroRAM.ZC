//Build a SELF-CONTAINED kernel: the whole OS embedded as a RedSea distro image
//inside Kernel.ZXE (Terry's DebugDistro mechanism), mounted at boot as RAM
//drive B:. The result needs no disk driver after load, so any loader that
//places the kernel in memory boots a full ZealOS: ZealBooter/Limine ISO
//(BIOS+UEFI), Ventoy, PXE.
//
//Run from an installed, writable system:  #include "::/Misc/DoDistroRAM"
//Output: ::/Tmp/RAMKernel.ZXE  (kernel + embedded OS image)
//Package on the host with build/build-ram-iso.sh.
//
//Too big for the native 16-bit boot loaders (they load below 640K);
//ZealBooter/Limine load anywhere, any size.

#define RAMDISTRO_IMAGE			"::/Tmp/RAMDistro.ISO.C"
#define RAMDISTRO_KERNEL		"::/Tmp/RAMKernel.ZXE"
//File offset of the embedded image within Kernel.ZXE. Must exceed the kernel
//code size (~0x60000). Embedded image runtime addr = mem_boot_base - sizeof(CZXE)
//+ RAMDISTRO_OFFSET; the matching DebugDistro start value = RAMDISTRO_OFFSET +
//BOOT_RAM_BASE (KMain's BINLOAD pad formula subtracts BOOT_RAM_BASE + sizeof(CZXE)).
#define RAMDISTRO_OFFSET		0x100000
#define RAMDISTRO_BOOT_DIR		"/Boot"
#define RAMDISTRO_KERNEL_ZXE	RAMDISTRO_BOOT_DIR "/Kernel.ZXE"
#define RAMDISTRO_DVD_KERNEL	RAMDISTRO_BOOT_DIR "/DVDKernel.ZXE"
//Standard DVD-distro build config (boot drive T, mount RAM B + booted DVD T).
#define RAMDISTRO_DVD_CONFIG	"TB\nScale2Mem(2048,0x40000)\nT\n\n\n\n"

U0 MakeRAMKernel()
{//Two kernel compiles: a stock DVD kernel that goes INTO the image, then the
//outer DebugDistro kernel that carries the image. Takes several minutes.
	U8			*cfg;
	CDirEntry	 de;

	if (!DriveIsWritable)
	{
		"Drive must be writable. Install on hard drive or USB first.\n";
		return;
	}

//--- Build the distro tree + a bootable RedSea/ISO image (same as MakeMyISO) ---
	DelTree("/Distro");
	Del(RAMDISTRO_IMAGE);
	DirMake("/Distro");
	In(RAMDISTRO_DVD_CONFIG);
	BootDVDIns;						//compiles DVD kernel -> /Boot/DVDKernel.ZXE
	Copy("/*", "/Distro");			//root files (StartOS.ZC, MakeHome.ZC, ...)
	DirMake("/Distro" RAMDISTRO_BOOT_DIR);
	Move(RAMDISTRO_DVD_KERNEL, "/Distro" RAMDISTRO_KERNEL_ZXE);
	CopyTree("/Home",		"/Distro/Home");
	Del("/Distro/Home/Registry.ZC");
	CopyTree("/System",		"/Distro/System");
	CopyTree("/Apps",		"/Distro/Apps");
	CopyTree("/Compiler",	"/Distro/Compiler");
	CopyTree("/Demo",		"/Distro/Demo");
	CopyTree("/Doc",		"/Distro/Doc");
	CopyTree("/Kernel",		"/Distro/Kernel");
	CopyTree("/Misc",		"/Distro/Misc");
	DirMake("/Distro/Tmp");
	DirMake("/Distro/Tmp/ScreenShots");
	RedSeaISO(RAMDISTRO_IMAGE, "/Distro", "/Distro" RAMDISTRO_KERNEL_ZXE);
	DelTree("/Distro");

	if (!FileFind(RAMDISTRO_IMAGE, &de, FUF_JUST_FILES))
	{
		"FAILED: distro image not built.\n";
		return;
	}
	"Distro image: %s (%d MB).\n", RAMDISTRO_IMAGE, de.size / 0x100000;
	Free(de.full_name);

//--- Compile the outer kernel: boot drive B = RAM disk at the embedded image
//    (drv_offset auto-set to the DVD offset by the Mount RAM path), and
//    DebugDistro = append the image inside Kernel.ZXE at RAMDISTRO_OFFSET.
//    Addr expression evaluates at BOOT, so it is correct wherever the loader
//    placed the kernel (native low-mem or Limine high-mem). ---
	"Compiling self-contained kernel...\n";
	cfg = MStrPrint(
		"BB"										//boot drive B, then Mount: select B
		"mem_boot_base - sizeof(CZXE) + 0x%X\n"		//RAM disk addr = embedded image
		"0x%X\n"									//blocks (image size, rounded up)
		"\n"										//exit Mount menu
		"\n"										//Disk Cache default
		"DebugDistro\n"								//toggle DebugDistro option on
		"%s\n"										//Debug Distro File
		"0x%X\n"									//Debug Distro Start
		"\n",										//done with options
		RAMDISTRO_OFFSET,
		(de.size + BLK_SIZE - 1) / BLK_SIZE,
		RAMDISTRO_IMAGE,
		RAMDISTRO_OFFSET + BOOT_RAM_BASE);
	In(cfg);
	Free(cfg);
	if (Comp("/Kernel/Kernel", "Kernel",, ':'))
	{
		"Kernel compile failed.\n";
		return;
	}
	Del(RAMDISTRO_KERNEL);
	Move("/Kernel/Kernel.ZXE", RAMDISTRO_KERNEL);

	if (FileFind(RAMDISTRO_KERNEL, &de, FUF_JUST_FILES))
	{
		"\nDone: %s (%d MB).\n", RAMDISTRO_KERNEL, de.size / 0x100000;
		"Copy it to the host and run build/build-ram-iso.sh.\n";
		Free(de.full_name);
	}
	else
		"FAILED: no output kernel.\n";
}

MakeRAMKernel;
